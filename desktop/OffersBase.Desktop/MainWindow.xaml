<Window x:Class="OffersBase.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Offers Base" Width="1280" Height="830" MinWidth="1000" MinHeight="680"
 Closing="WindowClosing">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><TextBlock Text="Offers Base" FontSize="24" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="offers.maharram.ru" Foreground="#666" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
  <Grid Grid.Row="1" x:Name="Sources" Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
   <TextBlock Text="Бекап" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="BackupPath" IsReadOnly="True" Margin="0,4"/>
   <Button Grid.Column="2" Click="ChooseBackup" ToolTip="Выбрать бекап"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;"/></Button>
   <TextBlock Grid.Row="1" Text="Организация" VerticalAlignment="Center"/>
   <ComboBox Grid.Row="1" Grid.Column="1" x:Name="Organization" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4" SelectionChanged="OrganizationChanged" VerticalContentAlignment="Center"/>
  </Grid>
  <TabControl Grid.Row="2" x:Name="Tabs" Background="White" BorderBrush="#D5D5D5">
   <TabItem Header="Публикация" Padding="14,8">
    <Grid Margin="20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="Папка репозитория" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="RepoPath" Margin="0,4"/>
     <Button Grid.Column="2" Click="ChooseRepository" ToolTip="Выбрать папку репозитория"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;"/></Button>
     <TextBlock Grid.Row="1" Text="Пароль сайта" VerticalAlignment="Center"/>
     <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="Password" Margin="0,4" MaxWidth="360" HorizontalAlignment="Left" MinWidth="280"/>
     <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Content="Опубликовать бекап" Click="PublishBackup" Margin="0,16,0,0"/>
     <TextBox Grid.Row="3" Grid.ColumnSpan="3" x:Name="PublishLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#FAFAFA" BorderBrush="#E5E5E5" Margin="0,22,0,0"/>
    </Grid>
   </TabItem>
   <TabItem Header="Платежи" Padding="14,8">
    <Grid Margin="14">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Выписка банка" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="BankPath" IsReadOnly="True" Margin="0,4"/>
      <Button Grid.Column="2" Click="ChooseBank" ToolTip="Выбрать выгрузку из банка"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;"/></Button>
      <Button Grid.Column="3" Click="MatchPayments" Content="Сопоставить"/>
     </Grid>
     <DockPanel Grid.Row="1" Margin="0,10"><TextBlock x:Name="MatchSummary" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Разделить платеж" Click="SplitPayment"/></DockPanel>
     <DataGrid Grid.Row="2" x:Name="PaymentsGrid" ItemsSource="{Binding Rows}" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="✓" Width="35"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Included, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Дата" Binding="{Binding Date}" IsReadOnly="True" Width="88"/>
       <DataGridTextColumn Header="Платеж, ₽" Binding="{Binding OriginalAmount, StringFormat=N2}" IsReadOnly="True" Width="95"/>
       <DataGridTextColumn Header="Распределить, ₽" Binding="{Binding AllocationAmount, UpdateSourceTrigger=PropertyChanged}" Width="115"/>
       <DataGridTextColumn Header="Плательщик" Binding="{Binding Payer}" IsReadOnly="True" Width="150"/>
       <DataGridTemplateColumn Header="Счет" Width="290"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Invoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding InvoiceId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" ToolTip="{Binding Purpose}" Margin="3"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Результат" Binding="{Binding Reason}" IsReadOnly="True" Width="180"/>
       <DataGridTemplateColumn Header="Назначение" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Purpose}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Purpose}" Margin="4" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Сохранить бекап" Click="SavePayments"/>
      <Button Content="Сохранить и опубликовать" Click="SaveAndPublish"/>
     </StackPanel>
    </Grid>
   </TabItem>
  </TabControl>
  <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="Status" Text="Выберите бекап" TextWrapping="Wrap" Foreground="#555"/><ProgressBar Grid.Column="1" x:Name="Progress" Height="5" Visibility="Collapsed" IsIndeterminate="True"/>
  </Grid>
 </Grid>
</Window>
